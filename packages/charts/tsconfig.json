{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.stories.tsx",
    "**/*.stories.mdx",
    "**/*.test.tsx",
    "**/*.test.ts",
    "**/__stories__",
    "**/__tests__",
    "**/__mocks__"
  ]
}
