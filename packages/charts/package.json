{
  "name": "@clera/charts",
  "version": "0.0.0",
  "private": false,
  "description": "Chart and data-visualization primitives for the Clera design system.",
  "author": {
    "name": "itsferdiardiansa"
  },
  "type": "module",
  "main": "dist/lib/index.js",
  "module": "dist/es/index.js",
  "types": "dist/es/index.d.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "rm -rf node_modules dist .cache coverage",
    "lint": "eslint --cache \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --cache \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit"
